{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azuredatafactory1125"
		},
		"AzureDataLakeStorage_Gen2_11_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_Gen2_11_ls'"
		},
		"AzureDatabricksDeltaLake_11_ls_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLake_11_ls'"
		},
		"AzureSqlDatabase_11_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_11_ls'"
		},
		"AzureDataLakeStorage_Gen2_11_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2storage11.dfs.core.windows.net/"
		},
		"AzureSqlDatabase_11_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "hospitalserver11.database.windows.net"
		},
		"AzureSqlDatabase_11_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().db_name}"
		},
		"AzureSqlDatabase_11_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"Coaches_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/Coaches.csv"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/blob/main/data/Athletes.csv"
		},
		"HttpServer2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/Athletes.csv"
		},
		"HttpServer3_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/EntriesGender.csv"
		},
		"HttpServer4_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/Teams.csv"
		},
		"Medals_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/Medals.csv"
		},
		"accounts_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/pnair11/CRM_Sales/raw/refs/heads/main/accounts.csv"
		},
		"data_dictionary_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/pnair11/CRM_Sales/raw/refs/heads/main/data_dictionary.csv"
		},
		"products_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/pnair11/CRM_Sales/raw/refs/heads/main/products.csv"
		},
		"sales_pipeline_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/pnair11/CRM_Sales/raw/refs/heads/main/sales_pipeline.csv"
		},
		"sales_teams_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/pnair11/CRM_Sales/raw/refs/heads/main/sales_teams.csv"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azuredatafactory1125_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_Gen2_11_ls_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_Gen2_11_ls_accountKey')]"
					},
					"AzureDatabricksDeltaLake_11_ls_accessToken": {
						"value": "[parameters('AzureDatabricksDeltaLake_11_ls_accessToken')]"
					},
					"AzureSqlDatabase_11_ls_password": {
						"value": "[parameters('AzureSqlDatabase_11_ls_password')]"
					},
					"AzureDataLakeStorage_Gen2_11_ls_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_Gen2_11_ls_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase_11_ls_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_11_ls_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_11_ls_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_11_ls_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_11_ls_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_11_ls_properties_typeProperties_userName')]"
					},
					"Coaches_ls_properties_typeProperties_url": {
						"value": "[parameters('Coaches_ls_properties_typeProperties_url')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"HttpServer2_properties_typeProperties_url": {
						"value": "[parameters('HttpServer2_properties_typeProperties_url')]"
					},
					"HttpServer3_properties_typeProperties_url": {
						"value": "[parameters('HttpServer3_properties_typeProperties_url')]"
					},
					"HttpServer4_properties_typeProperties_url": {
						"value": "[parameters('HttpServer4_properties_typeProperties_url')]"
					},
					"Medals_properties_typeProperties_url": {
						"value": "[parameters('Medals_properties_typeProperties_url')]"
					},
					"accounts_ls_properties_typeProperties_url": {
						"value": "[parameters('accounts_ls_properties_typeProperties_url')]"
					},
					"data_dictionary_ls_properties_typeProperties_url": {
						"value": "[parameters('data_dictionary_ls_properties_typeProperties_url')]"
					},
					"products_ls_properties_typeProperties_url": {
						"value": "[parameters('products_ls_properties_typeProperties_url')]"
					},
					"sales_pipeline_ls_properties_typeProperties_url": {
						"value": "[parameters('sales_pipeline_ls_properties_typeProperties_url')]"
					},
					"sales_teams_ls_properties_typeProperties_url": {
						"value": "[parameters('sales_teams_ls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "azuredatafactory1125_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'azuredatafactory1125_ArmTemplate_0')]"
			]
		}
	]
}